project('applaunch', 'vala', 'c', default_options : ['optimization=2'])

glib = dependency('glib-2.0')
gobject = dependency('gobject-2.0')
gtk4 = dependency('gtk4')
libadwaita = dependency('libadwaita-1')
gtk4_layer_shell = dependency('gtk4-layer-shell-0')
gio_unix = dependency('gio-unix-2.0')
gio = dependency('gio-2.0')
appstream = dependency('appstream')
json_glib = dependency('json-glib-1.0')
gee = dependency('gee-0.8')
gtk4_wayland = dependency('gtk4-wayland', version: '>=4.18')
wayland_client = dependency('wayland-client')
wayland_protocols = dependency('wayland-protocols', native: true)
math = meson.get_compiler('c').find_library('m')

subdir('src')
